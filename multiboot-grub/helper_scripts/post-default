%post --interpreter=/usr/bin/bash --log=/tmp/post-kickstart.log --erroronfail

systemctl enable sshd
systemctl enable chronyd
systemctl enable NetworkManager
systemctl enable serial-getty@ttyS0.service

echo 'ansible ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/ansible

ansible-galaxy collections install -p /usr/share/ansible/collections/ -r <( cat <<EOF
---
collections:
    - community.crypto
    - community.general
    - ansible.posix
EOF
)


%end

