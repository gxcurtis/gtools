{
   "lang": "en_US.UTF-8",
   "keyboard": {
      "vckeymap": "us",
      "xlayouts": "us"
   },
   "timezone": "Etc/UTC",
   "firstboot": "disable",
   "eula": "agreed",
   "firewall": {
      "system_defaults": true,
      "enabled": true,
      "ssh": true,
      "http": false,
      "ftp": false,
      "smtp": false,
      "port": [],
      "service": []
   },
   "network": {
      "bootproto": "dhcp",
      "hostname": "",
      "device": "link",
      "activate": true,
      "ipv4": {
         "enabled": true,
         "address": "",
         "gateway": "",
         "netmask": "",
         "dns_search": "",
         "auto_dns": true
      },
      "ipv6": {
         "enabled": true,
         "address": "",
         "gateway": "",
         "dns_search": "",
         "auto_dns": true
      },
      "no_defroute": "",
      "no_dns": false,
      "nameservers": [],
      "mtu": 1500,
      "bond": {
         "slaves": [],
         "opts": []
      },
      "vlan": {
         "id": 0,
         "interface_name": ""
      },
      "bridge": {
         "slaves": [],
         "opts": []
      }
   },
   "selinux": "enforcing",
   "rootpw": {
      "iscrypted": true,
      "locked": true,
      "password": ""
   },
   "bootloader": {
      "append": [
         "console=tty0",
         "console=ttyS0,115200n8"
      ],
      "iscrypted": true,
      "password": "",
      "superuser": "root"
   },
   "partition": {
      "strategy": "pre_include",
      "pre_content": "",
      "custom": ""
   },
   "packages": [
      "@core",
      "git",
      "curl",
      "tmux",
      "rsync",
      "openssl",
      "tcpdump",
      "nmap-ncat",
      "vim-enhanced",
      "bash-completion",
      "openscap-scanner",
      "scap-security-guide",
      "python3",
      "python3-pip",
      "ansible-core",
      "policycoreutils-python-utils",
      "bind-utils",
      "yum-utils",
      "nfs-utils",
      "info",
      "man-db",
      "man-pages",
   ],
   "pre_sections": [
      {
      "interpreter": "/usr/bin/bash",
      "erroronfail": true,
      "log_file": "/tmp/pre-kickstart.log"
      }
   ],
   "post_sections": [
      {
      "interpreter": "/usr/bin/bash",
      "erroronfail": true,
      "log_file": "/root/post-kickstart.log",
      "chroot": false
      }
   ]
}
