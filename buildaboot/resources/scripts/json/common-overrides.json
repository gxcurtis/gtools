{
   "timezone": "America/XXXXXX",
   "timesource": {
      "servers": ["X.X.X.X","X.X.X.X"]
   },
   "firewall": {
      "enabled": true,
      "system_defaults": false,
      "ssh": true,
      "ports": [],
      "services": []
   },
   "network": {
      "bootproto": "static",
      "hostname": "-X-HOSTNAME",
      "ipv4": {
         "address": "X.X.X.X",
         "gateway": "X.X.X.X",
         "dns_search": "-X-SEARCH.DOMAIN"
      }
   },
   "rootpw": {
      "iscrypted": true,
      "locked": false,
      "password": "-X-PASSWORD-HASH"
   },
   "bootloader": {
      "iscrypted": true,
      "password": "-X-PASSWORD-HASH",
      "superuser": "-X-USER"
   },
   "users": [
      {
         "name": "ansible",
         "password": "",
         "iscrypted": true,
         "homedir": "/home/ansible",
         "shell": "/bin/bash",
         "gecos": "Ansible Admin",
         "groups": ["wheel"],
         "sshkey": ""
      }  
   ]
}
