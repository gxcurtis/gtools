" Core Settings
set encoding=utf-8
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set autoindent
set number
set numberwidth=1
syntax on
filetype plugin on
for scheme in ['apprenctice', 'slate', 'default']
    try
        execute 'colorscheme ' . scheme
        break
    catch /^Vim.*:E185/
    endtry
endfor

" Navigation keybindings
inoremap <C-j> <Esc>
nnoremap j h
nnoremap k j
nnoremap l k
nnoremap ; l
nnoremap h ;

vnoremap j h
vnoremap k j
vnoremap l k
vnoremap ; l
vnoremap h ;

onoremap j h
onoremap k j
onoremap l k
onoremap ; l
onoremap h ;

nnoremap <C-w>j <C-w>h
nnoremap <C-w>k <C-w>j
nnoremap <C-w>l <C-w>k
nnoremap <C-w>; <C-w>l
nnoremap <C-w>h <C-w>;

" YAML, HTML, CSS 
augroup ft_others
  autocmd!
  autocmd FileType yaml,html,css setlocal expandtab tabstop=2 softtabstop=2 shiftwidth=2
augroup END

" User defined commands
command! Shellcheck execute '!shellcheck ' . shellescape(expand('%:p'))
command! Ruffcheck execute '!ruff check ' . shellescape(expand('%:p'))
command! Ruffcheckfix execute '!ruff check --fix ' . shellescape(expand('%:p'))
command! Ansiblelint execute '!ansible-lint ' . shellescape(expand('%:p'))
