#!/usr/bin/env bash

# NOTE: Bash function names with `-` are not portable to posix shells like /bin/sh

# Git
gitm() {
    git add -A
    git commit -m "$1"
    git push
}

# Message border spanning terminal width
msgborder() {
    local OPTIND=1
    local OPTARG opt line padding
    local char='='
    local color=15
    local width="$COLUMNS"
    local msg=''

    while getopts ":s:c:w:m:" opt; do
        case "$opt" in
            s) char="$OPTARG"
            ;;
            c) color="$OPTARG"
            ;;
            w) width="$OPTARG"
            ;;
            m) msg="$OPTARG"
            ;;
            :) printf 'Missing argument: -%s\n' "$OPTARG" >&2 ; exit 2
            ;;
            \?) printf 'Invalid option: -%s' "$OPTARG" >&2 ; exit 2
            ;;
        esac
    done

    color=$((color % 256))

    if [[ -z $msg ]]; then
        printf -v line '%*s' "$width" ''
        printf '\033[38;5;%sm%s\033[0m\n' "$color" "${line// /$char}"
    else
{% raw %}
        width=$((width - ${#msg} - 1))
{% endraw %}
        printf -v line '%*s' "$width" ''
        printf '\033[38;5;%sm%s ' "$color" "$msg"
        printf '%s\033[0m\n' "${line// /$char}"
    fi
}

# find + xargs
findx() {
  local target
  target="$1"

  find "$target" -mindepth 1 -maxdepth 1 -print0 | xargs -0 -r -I{} -P8 
}

# Prompt
prompt_env() {
  local branch
  if [[ -n "${VIRTUAL_ENV:-}" ]]; then
    printf '(%s)' "$(basename "$VIRTUAL_ENV")"
  elif branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null); then
    printf '%s' "$branch"
  else
    printf '%(%H:%M:%S)T' -1
  fi
}

