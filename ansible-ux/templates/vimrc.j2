" Core Settings
set encoding=utf-8
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set nosmartindent
set number
set numberwidth=1
syntax enable
filetype plugin indent on
for scheme in ['apprenctice', 'slate', 'default']
    try
        execute 'colorscheme ' . scheme
        break
    catch /^Vim.*:E185/
    endtry
endfor

" Navigation keybindings
let mapleader = " "

inoremap <C-j> <Esc>
inoremap <C-f> <C-x><C-o>

noremap j h
noremap k j
noremap l k
noremap ; l
noremap h ;

nnoremap <C-w>j <C-w>h
nnoremap <C-w>k <C-w>j
nnoremap <C-w>l <C-w>k
nnoremap <C-w>; <C-w>l
nnoremap <C-w>h <C-w>;

" User defined commands
command! -nargs=* Shellcheck execute '!shellcheck ' . shellescape(expand('%:p'))
command! -nargs=* Ruffcheck execute '!ruff check ' . shellescape(expand('%:p'))
command! Sdverify execute '!systemd-analyze verify ' . shellescape(expand('%:p'))
command! Ansiblelint execute '!ansible-lint ' . shellescape(expand('%:p'))

" Templates as commands
{% for vt in vim_templates %}
command! {{ vt.cmd_name | title }} execute 'read' fnameescape(expand('~/.vim/templates/{{ vt.filename }}'))
{% endfor %}

" Auto commands
autocmd BufNewFile *.{yml,yaml} call append(0, '---')
autocmd BufNewFile *.{sh,bash} call append(0, '#!/usr/bin/env bash')
autocmd BufNewFile *.py call append(0, '#!/usr/bin/env python3')

augroup two_space
  autocmd!
  autocmd BufRead,BufNewFile *.j2 setfiletype jinja
  autocmd FileType jinja,jinja2,htmldjango,yaml setlocal expandtab tabstop=2 softtabstop=2 shiftwidth=2
augroup END

augroup ansible_filetype
    autocmd!
    autocmd BufRead,BufNewFile */tasks/*.yml,*/tasks/*.yaml set filetype=yaml.ansible
    autocmd BufRead,BufNewFile */handlers/*.yml,*/handlers/*.yaml set filetype=yaml.ansible
    autocmd BufRead,BufNewFile */playbooks/*.yml,*/playbooks/*.yaml set filetype=yaml.ansible
    autocmd BufRead,BufNewFile playbook.yml,site.yml set filetype=yaml.ansible
augroup END

" LSP Settings
let g:lsp_diagnostics_enabled = 1
let g:lsp_diagnostics_echo_cursor = 1
set completeopt=menuone,noselect,popup

" Navigate popup menus
inoremap <expr> <Tab> pumvisible() ? "\<C-n>" : "\<Tab>"
inoremap <expr> <S-Tab> pumvisible() ? "\<C-p>" : "\<S-Tab>"
inoremap <expr> <CR> pumvisible() ? "\<C-y>" : "\<CR>"
noremap <expr> <C-f> lsp#scroll(+4)
noremap <expr> <C-d> lsp#scroll(-4)

" Shortcuts
nnoremap <silent> gd :LspGotoDefinition<CR>
nnoremap <silent> gr :LspShowReferences<CR>
nnoremap <silent> K :LspHover<CR>
nnoremap <silent> <leader>rn :LspRename<CR>
nnoremap <silent> <leader>ca :LspCodeAction<CR>

" Python Language Server
augroup PythonLSP
    autocmd!
    autocmd User LspSetup call LspAddServer([#{ name: 'pylsp', filetype: 'python', path: 'pylsp', args: [] }])
augroup END

