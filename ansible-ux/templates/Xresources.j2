! Font
XTerm*renderFont: true
XTerm*faceName: JetBrains Mono,DejaVu Sans Mono
XTerm*faceSize: 12

! Window size: columns x rows
XTerm*geometry: 120x35
XTerm*internalBorder: 8

! Dark appearance
XTerm*background: #161b22
XTerm*foreground: #d6deeb
XTerm*cursorColor: #80cbc4

! Cursor: solid block
XTerm*cursorBlink: false
XTerm*cursorUnderLine: false

! Scrollback
XTerm*saveLines: 10000
XTerm*scrollBar: false
XTerm*scrollTtyOutput: false
XTerm*scrollKey: true

! Send Alt combinations as Escape followed by the key
XTerm*altIsNotMeta: true
XTerm*altSendsEscape: true
XTerm*metaSendsEscape: true

! Advertise 256-color support
XTerm*termName: xterm-256color

! Automatically copy selected text to the system clipboard
XTerm*selectToClipboard: true

! Ctrl+Shift+C to copy; Ctrl+Shift+V to paste
XTerm*VT100.Translations: #override \n\
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD)
