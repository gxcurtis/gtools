%post --interpreter=/usr/bin/bash --log=/root/post-kickstart.log

{%- if bootloader.superuser != 'root' %}

# Reconfigure grub bootloader user from default 'root'
sed -i \
    -e 's/set superusers="root"/set superusers="{{ bootloader.superuser }}"/' \
    -e 's/password_pbkdf2 root /password_pbkdf2 {{ bootloader.superuser }} /' \
    /etc/grub.d/01_users

if [ -d /sys/firmware/efi ]; then
    grub2-mkconfig -o /etc/grub2-efi.cfg
else
    grub2-mkconfig -o /etc/grub2.cfg
fi
{% endif %}
{%- if openscap.hardening %}
{%- if firewall.enabled %}
# Configure firewalld default zone to 'drop' per DISA STIG
target_zone=drop
services=$(firewall-offline-cmd --list-services)
ports=$(firewall-offline-cmd --list-ports)

for service in $services; do
    firewall-offline-cmd --zone="$target_zone" --add-service="$service"
done

for port in $ports; do
  firewall-offline-cmd --zone="$target_zone" --add-port="$port"
done

firewall-offline-cmd --set-default-zone="$target_zone"
{%- endif %}

# Update OpenSSH Ciphers + MACs per DISA STIG
ssh_crypto_config=/etc/crypto-policies/back-ends/openssh.config
if [[ -f $ssh_crypto_config ]]; then
   cp "$ssh_crypto_config" "${ssh_crypto_config}.bak" || exit 1

   if sed -E -i \
      -e 's/^[#[:space:]]*Ciphers[[:space:]]+.*$/Ciphers aes256-ctr,aes192-ctr,aes128-ctr,aes256-gcm@openssh.com,aes128-gcm@openssh.com/g' \
      -e 's/^[#[:space:]]*MACs[[:space:]]+.*$/MACs hmac-sha2-512,hmac-sha2-256,hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com/g' \
      "$ssh_crypto_config"
   then
      echo "Processed OpenSSH Ciphers & MACs: $ssh_crypto_config"
   fi
else
   echo "ERROR: file not found $ssh_crypto_config"
fi

# Update OpenSSH Server Ciphers + MACs per DISA STIG
sshserver_crypto_config=/etc/crypto-policies/back-ends/opensshserver.config
if [[ -f $sshserver_crypto_config ]]; then
   cp "$sshserver_crypto_config" "${sshserver_crypto_config}.bak"

   if sed -E -i \
      -e 's/-oCiphers=[[:graph:]]+/-oCiphers=aes256-ctr,aes192-ctr,aes128-ctr,aes256-gcm@openssh.com,aes128-gcm@openssh.com/g' \
      -e 's/-oMACs=[[:graph:]]+/-oMACs=hmac-sha2-512,hmac-sha2-256,hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com/g' \
      "$sshserver_crypto_config"
   then
      echo "Processed OpenSSH Server Ciphers & MACs: $sshserver_crypto_config"
   fi
else
   echo "ERROR: file not found $sshserver_crypto_config"
fi

# Update GnuTLS Crypto Policy
gnutls_crypto_config=/etc/crypto-policies/back-ends/gnutls.config
if [[ -f $gnutls_crypto_config ]]; then
   cp "$gnutls_crypto_config" "${gnutls_crypto_config}.bak" || exit 1

   if sed -E -i \
      -e 's/\+VERS-ALL(:-VERS-[A-Z]+[0-9]+\.[0-9]+)+/+VERS-ALL:-VERS-DTLS0.9:-VERS-SSL3.0:-VERS-TLS1.0:-VERS-TLS1.1:-VERS-DTLS1.0/g' \
      "$gnutls_crypto_config"
   then
      echo "Processed GnuTLS Crypto Policy: $gnutls_crypto_config"
   fi
else
   echo "ERROR: file not found $gnutls_crypto_config"
fi

# PW Quality 3 retries
if sed -i -E \
    's/^[[:space:]]*#?[[:space:]]*retry[[:space:]]*=.*/retry = 3/' \
    /etc/security/pwquality.conf
then
  echo "Processed pwquality.conf to include retry=3"

{%- endif %}

%end
