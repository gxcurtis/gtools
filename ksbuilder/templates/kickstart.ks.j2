# Produced by ksbuilder
lang {{ lang }}
keyboard --vckeymap={{ keyboard.vckeymap }} --xlayouts='{{ keyboard.xlayouts }}'
timezone {{ timezone }} --utc
{%- if timesource.ntp_disable %}
timesource --ntp-disable
{%- elif timesource.servers %}
  {%- for server in timesource.servers %}
timesource --ntp-server={{ server }}
  {%- endfor %}
{%- elif timesource.pools %}
  {%- for pool in timesource.pools %}
timesource --ntp-pool={{ pool }}
  {%- endfor %}
{%- endif %}

{{ interface_type }}
{{ system_action }}
firstboot --{{ firstboot }}
eula --{{ eula }}
{%- for repo in software.repos %}
{%- if repo.name and repo.baseurl %}
repo --name={{ repo.name }} --baseurl={{ repo.baseurl }} {%- if repo.install %} --install{% endif %}
{%- endif %}
{%- endfor %}

network --bootproto={{ network.bootproto }} --device={{ network.device }}
{%- if network.activate %} --activate{% endif %}
{%- if network.hostname %} --hostname={{ network.hostname }}{% endif %}

{%- if network.ipv4.enabled %}

  {%- if network.bootproto == 'dhcp' %}
    {%- if network.ipv4.dns_search %} --ipv4-dns-search={{ network.ipv4.dns_search }}{% endif %}
    {%- if not network.ipv4.auto_dns %} --ipv4-ignore-auto-dns{% endif %}

  {%- elif network.bootproto == 'static' %}
    {%- if network.ipv4.address %} --ip={{ network.ipv4.address }}{% endif %}
    {%- if network.ipv4.gateway %} --gateway={{ network.ipv4.gateway }}{% endif %}
    {%- if network.ipv4.netmask %} --netmask={{ network.ipv4.netmask }}{% endif %}
    {%- if network.ipv4.dns_search %} --ipv4-dns-search={{ network.ipv4.dns_search }}{% endif %}

  {%- endif %}

{%- else %}
 --noipv4 
{%- endif %}

{%- if network.ipv6.enabled %}

  {%- if network.bootproto == 'dhcp' %}
    {%- if network.ipv6.dns_search %} --ipv6-dns-search={{ network.ipv6.dns_search }} {% endif %}
    {%- if not network.ipv6.auto_dns %} --ipv6-ignore-auto-dns{% endif %}

  {%- elif network.bootproto == 'static' %}
    {%- if network.ipv6.address %} --ipv6={{ network.ipv6.address }}{% endif %}
    {%- if network.ipv6.gateway %} --ipv6gateway={{ network.ipv6.gateway }}{% endif %}
    {%- if network.ipv6.dns_search %} --ipv6-dns-search={{ network.ipv6.dns_search }} {% endif %}

  {%- endif %}

{%- else %} --noipv6
{%- endif %}
  
{%- if network.mtu | int != 1500 %} --mtu={{ network.mtu }}{% endif %}
{%- if network.no_defroute %} --nodefroute{% endif %}
{%- if network.no_dns %} --nodns{% endif %}
{%- if network.nameservers %} --nameserver={{ network.nameservers | join(',') }}{% endif %}
{%- if network.bond.slaves %} --bondslaves={{ network.bond.slaves | join(',') }}{% endif %}
{%- if network.bond.opts %} --bondopts={{ network.bond.opts | join(',') }}{% endif %}
{%- if network.vlan.id | int != 0 %} --vlanid={{ network.vlan.id }} {%- if network.vlan.interface_name %} --interfacename={{ network.vlan.interface_name }}{% endif %}{% endif %}
{%- if network.bridge.slaves %} --bridgeslaves={{ network.bridge.slaves | join(',') }}{% endif %}
{%- if network.bridge.opts %} --bridgeopts={{ network.bridge.opts | join(',') }}{% endif %}

{%- if not firewall.enabled  %}
firewall --disable
{%- elif firewall.system_defaults %}
firewall --enable --use-system-defaults
{%- else %}
firewall --enable
  {%- if firewall.ssh %} --ssh{% endif %}
  {%- if firewall.http %} --http{% endif %}
  {%- if firewall.ftp %} --ftp{% endif %}
  {%- if firewall.smtp %} --smtp{% endif %}
  {%- if firewall.ports %} --port={{ firewall.ports | join(',') }}{% endif %}
  {%- if firewall.services %} --service={{ firewall.services | join(',') }}{% endif %}
{%- endif %}
{%- if logging.host %}
logging --host={{ logging.host }}
  {%- if logging.port %} --port={{ logging.port }}{% endif %}
{% endif %}

{% if selinux %}selinux --{{ selinux }}{% endif %}
rootpw {%- if rootpw.locked %} --lock{% endif %}
{%- if rootpw.password %}
{%- if rootpw.iscrypted %} --iscrypted {% endif -%}
 {{ rootpw.password }}
{% endif %} 
bootloader --location={{ bootloader.location }}
{%- if bootloader.location != 'none' %}
  {%- if bootloader.args %} --append="{{ bootloader.args | join(' ') }}"{% endif %}
  {%- if bootloader.password %}
    {%- if bootloader.iscrypted %} --iscrypted --password={{ bootloader.password }}
    {%- else %} --password={{ bootloader.password }}
    {%- endif %} # Bootloader superuser: {{ bootloader.superuser | default('root') }}
  {%- endif %}
{%- endif %}
{% for user in users %}
user --name={{ user.name }}
  {%- if user.password %} --password={{ user.password }}
    {%- if user.iscrypted %} --iscrypted{% endif %}
  {%- endif %}
{%- if user.homedir %} --homedir={{ user.homedir }}{% endif %}
{%- if user.shell %} --shell={{ user.shell }}{% endif %}
{%- if user.gecos %} --gecos='{{ user.gecos }}'{% endif %}
{%- if user.groups %} --groups={{ user.groups | join(' ') }}{% endif %}
{%- if user.sshkey %}sshkey --username={{ user.name }} "{{ user.sshkey }}"{%- endif %}
{%- endfor %}

%include {{ storage.includefile }}

{% include storage.template -%}

{%- if pre_ks_templates %}
{%- for template in pre_ks_templates %}
{%- include template %}

{%- endfor %}
{%- endif %}
%packages
{%- if not software.core_packages and not software.packages %} --default 
{%- else %}
{%- if software.ignore_missing %} --ignoremissing{% endif %}
{%- if not software.weak_deps %} --exclude-weakdeps{% endif %}
{%- if software.ignore_broken %} --ignorebroken{% endif %}

{%- for package in (software.core_packages + software.packages) | unique | sort %}
{{ package }}
{%- endfor %}

%end

{%- if openscap.hardening %}

%addon org_fedora_oscap
  content-type = {{ openscap.content_type }}
  profile = {{ openscap.profile }}
%end
{%- endif %}

{% if post_ks_templates %}
{%- for template in post_ks_templates %}
{%- include template %} 

{%- endfor %}
{%- endif %}
{%- endif -%}

