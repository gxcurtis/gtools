#!/usr/bin/env bash
# shellcheck disable=SC2034
SCRIPT="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd -P)"

# Display help message with -h
print_help() {
    cat <<EOF

usage: $SCRIPT

options:
    -o (Set OS Variant)
    -n (Set VM name)
    -c (Set vCPU count to allocate)
    -m (Set Memory in MiB)
    -d (Set Disk size in GiB)
    -i (Set secondary install disk)
    -p (Set VM pool)
    -b (Set bridge interface)
    -H (Set Hardware MAC address)
    -h (Print this help text)

EOF
}

OSVAR=linux2024
VMNAME="$(shuf -n1 /usr/share/dict/words)-vm"
VCPUS=2
MEMORY=4096
DISK=64
INSTALL_DISK='/storage/vmpool/master.img'
VMPOOL=vmpool
BRIDGE=br0
HWADDR='RANDOM'

# Set Options/Arguments
while getopts ':o:n:c:m:d:i:p:b:hH:' opt; do
    case "$opt" in
        o) OSVAR="$OPTARG" ;;
        n) VMNAME="$OPTARG" ;;
        c) VCPUS="$OPTARG" ;;
        m) MEMORY="$OPTARG" ;;
        d) DISK="$OPTARG" ;;
        i) INSTALL_DISK="$OPTARG" ;;
        p) VMPOOL="$OPTARG" ;;
        b) BRIDGE="$OPTARG" ;;
        H) HWADDR="$OPTARG" ;;
        h) print_help && exit 0 ;;
        :) printf 'Missing argument -%s\n' "$OPTARG" && exit 1 ;;
        \?) printf 'Invalid argument -%s\n' "$OPTARG" && exit 1 ;;
    esac
done

shift "$(( OPTIND - 1 ))"

### Main ###

main() {
    virt-install \
        --name "$VMNAME" \
        --os-variant "$OSVAR" \
        --vcpus "$VCPUS" \
        --memory "$MEMORY" \
        --disk pool="$VMPOOL",size="$DISK",boot.order=1 \
        --disk path="$INSTALL_DISK",format=raw,boot.order=2 \
        --network bridge="$BRIDGE",model=virtio,mac="$HWADDR" \
        --serial pty \
        --graphics none \
        --boot loader=/usr/share/edk2/ovmf/OVMF_CODE.fd,loader.readonly=on,loader.type=pflash &&

        echo "Detaching install disk: $INSTALL_DISK" && virsh detach-disk "$VMNAME" vdb --persistent

    exit 0
}

main

